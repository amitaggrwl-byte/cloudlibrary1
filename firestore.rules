rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function signedIn() {
      return request.auth != null;
    }
    
    function validShelfName() {
      return request.resource.data.libraryName is string
             && request.resource.data.libraryName.matches('^[A-Za-z0-9]{3,32}$')
             && request.resource.data.shelfKey is string;
    }

    match /profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && request.auth.uid == userId
                            && validShelfName();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /books/{bookId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /friendships/{friendshipId} {
      // Broadened to support global queries like loadFriendsList() and loadPublicStats()
      allow read: if signedIn();
      
      allow create: if signedIn()
                    && request.resource.data.user1 == request.auth.uid
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.user2 != request.auth.uid;
                    
      allow update: if signedIn()
                    && request.auth.uid == resource.data.user2
                    && resource.data.status == 'pending'
                    && request.resource.data.status in ['accepted', 'declined']
                    && request.resource.data.user1 == resource.data.user1
                    && request.resource.data.user2 == resource.data.user2;
                    
      allow delete: if signedIn()
                    && (request.auth.uid == resource.data.user1
                        || request.auth.uid == resource.data.user2);
    }

    // Fully restored requests block
    match /requests/{requestId} {
      allow read: if signedIn()
                  && (request.auth.uid == resource.data.ownerId
                      || request.auth.uid == resource.data.requesterId);
                      
      // Requesters can create borrow requests; Owners can create return reminders
      allow create: if signedIn()
                    && (request.resource.data.requesterId == request.auth.uid 
                        || request.resource.data.ownerId == request.auth.uid);
                        
      // Both parties can update based on context (owner approves/marks returned, requester marks reminder complete)
      allow update: if signedIn()
                    && (resource.data.ownerId == request.auth.uid 
                        || resource.data.requesterId == request.auth.uid);
                        
      // The app does not delete requests (it only updates their status to completed/returned/declined)
      allow delete: if false;
    }
  }
}
