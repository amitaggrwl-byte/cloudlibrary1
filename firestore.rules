rules_version = '2';

// CloudLibrary clean-launch rules. Firebase Functions performs loan, return,
// loss, and accepted-friendship state changes with Admin credentials.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(id) { return signedIn() && request.auth.uid == id; }
    function validShelfName(data) {
      return data.libraryName is string
        && data.libraryName.matches('^[A-Za-z0-9]{3,32}$')
        && data.shelfKey is string;
    }
    function publicProfileFields(data) {
      return data.keys().hasOnly([
        'libraryName', 'shelfKey', 'ownerName', 'photoURL', 'bio',
        'ratingScore', 'ratingAdjustment', 'bookCount', 'timelyReturns', 'totalLent', 'memberSince',
        'searchTokens', 'circleTags', 'updatedAt'
      ]);
    }
    function profileEditableFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'ownerName', 'photoURL', 'bio',
        'searchTokens', 'updatedAt'
      ]) && (
        request.resource.data.ratingScore == resource.data.ratingScore
        && request.resource.data.ratingAdjustment == resource.data.ratingAdjustment
        && request.resource.data.bookCount == resource.data.bookCount
        && request.resource.data.timelyReturns == resource.data.timelyReturns
        && ((!resource.data.keys().hasAll(['totalLent']) && request.resource.data.totalLent == 0)
          || request.resource.data.totalLent == resource.data.totalLent)
        && request.resource.data.memberSince == resource.data.memberSince
        && (
          (!resource.data.keys().hasAll(['circleTags']) && request.resource.data.circleTags == [])
          || request.resource.data.circleTags == resource.data.circleTags
        )
      );
    }
    function friendshipKey(firstUserId, secondUserId) {
      return firstUserId < secondUserId
        ? firstUserId + '__' + secondUserId
        : secondUserId + '__' + firstUserId;
    }
    function areConfirmedFriends(firstUserId, secondUserId) {
      return firstUserId != secondUserId
        && exists(/databases/$(database)/documents/friendships/$(friendshipKey(firstUserId, secondUserId)))
        && get(/databases/$(database)/documents/friendships/$(friendshipKey(firstUserId, secondUserId))).data.status == 'accepted';
    }
    function hasLegacyBookAccess(data, userId) {
      return data.keys().hasAll(['readerIds']) && userId in data.readerIds;
    }
    function canReadBook() {
      return signedIn() && (
        resource.data.ownerId == request.auth.uid
        || resource.data.borrowerId == request.auth.uid
        || hasLegacyBookAccess(resource.data, request.auth.uid)
        || areConfirmedFriends(resource.data.ownerId, request.auth.uid)
      );
    }
    function validBookCreate(data) {
      return data.keys().hasOnly([
          'title', 'author', 'seriesName', 'seriesNumber', 'genre', 'isbn', 'publishedYear', 'condition',
          'coverUrl', 'description', 'rating', 'status', 'ownerId', 'ownerName',
          'quietImport', 'createdAt'
        ])
        && data.ownerId == request.auth.uid
        && data.status in ['Available', 'Reading'];
    }
    function validReturnReminder(data) {
      return data.bookId is string
        && data.requesterId is string
        && data.requesterId != request.auth.uid
        && data.ownerId == request.auth.uid
        && data.status == 'pending'
        && exists(/databases/$(database)/documents/books/$(data.bookId))
        && get(/databases/$(database)/documents/books/$(data.bookId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/books/$(data.bookId)).data.status == 'Lent Out'
        && get(/databases/$(database)/documents/books/$(data.bookId)).data.borrowerId == data.requesterId;
    }

    // Public discovery profiles contain no email address or other contact data.
    match /profiles/{userId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 10;
      allow create: if own(userId) && validShelfName(request.resource.data)
        && publicProfileFields(request.resource.data)
        && existsAfter(/databases/$(database)/documents/shelfNames/$(request.resource.data.shelfKey))
        && getAfter(/databases/$(database)/documents/shelfNames/$(request.resource.data.shelfKey)).data.ownerId == request.auth.uid
        && request.resource.data.ratingScore == 3
        && request.resource.data.ratingAdjustment == 0
        && request.resource.data.bookCount == 0
        && request.resource.data.timelyReturns == 0
        && request.resource.data.totalLent == 0
        && request.resource.data.circleTags == []
        && request.resource.data.memberSince is timestamp;
      allow update: if own(userId) && validShelfName(request.resource.data)
        && publicProfileFields(request.resource.data) && profileEditableFields();
      allow delete: if own(userId);
    }

    match /shelfNames/{shelfKey} {
      allow get: if signedIn();
      allow create: if own(request.resource.data.ownerId)
        && request.resource.data.keys().hasOnly(['ownerId', 'createdAt'])
        && existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid));
      allow delete: if own(resource.data.ownerId) && !existsAfter(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    // Complete book records are visible only to the owner, active borrower, or
    // readers explicitly added by the accepted-friend Function.
    match /books/{bookId} {
      allow get: if canReadBook();
      allow list: if canReadBook() && request.query.limit != null && request.query.limit <= 150;
      allow create: if signedIn() && validBookCreate(request.resource.data);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && (request.resource.data.status == resource.data.status
          || (resource.data.status in ['Available', 'Reading']
            && request.resource.data.status in ['Available', 'Reading']))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'author', 'seriesName', 'seriesNumber', 'genre', 'isbn', 'publishedYear', 'condition',
          'coverUrl', 'description', 'rating', 'status', 'updatedAt'
        ]);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid
        && resource.data.status != 'Lent Out';
    }

    // Search sees only the compact, deliberately non-sensitive card data.
    match /bookDiscovery/{bookId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 10;
      allow write: if false;
    }

    // Small, server-written ticker records. Book-related activity is visible
    // only to the specific confirmed friend it was written for.
    match /tickerActivities/{activityId} {
      allow get: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 6
        && resource.data.recipientId == request.auth.uid;
      allow write: if false;
    }

    // New-reader announcements contain only already-public profile details.
    match /networkTicker/{activityId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 2;
      allow write: if false;
    }

    // Aggregates are maintained by trusted Functions. Personal title/count
    // details are private, while the community record is anonymous.
    match /readerStats/{userId} {
      allow get, list: if own(userId);
      allow write: if false;
    }

    match /networkStats/{statsId} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    // Circles are created and maintained by the app administrator. Readers
    // may only join or leave through trusted Functions, which enforce the cap.
    match /circles/{circleId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 50;
      allow write: if false;
    }

    match /circleMemberships/{membershipId} {
      allow get: if signedIn() && resource.data.userId == request.auth.uid;
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 20
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /bookLoanStats/{bookId} {
      allow read, write: if false;
    }

    match /friendships/{friendshipId} {
      allow get: if signedIn() && (resource.data.user1 == request.auth.uid || resource.data.user2 == request.auth.uid);
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 100
        && (resource.data.user1 == request.auth.uid || resource.data.user2 == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.user1 == request.auth.uid
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.user2 != request.auth.uid
        && request.resource.data.status == 'pending';
      // Acceptance is handled by respondToFriendRequest. This prevents a client
      // from claiming an accepted relationship without also sharing both shelves.
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.status == 'pending'
        && resource.data.user1 == request.auth.uid;
    }

    match /requests/{requestId} {
      allow get: if signedIn() && (resource.data.ownerId == request.auth.uid || resource.data.requesterId == request.auth.uid);
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 100
        && (resource.data.ownerId == request.auth.uid || resource.data.requesterId == request.auth.uid);
      // Borrow requests are created by createBorrowRequest so caps, duplicate
      // prevention, and friendship checks cannot be bypassed from the browser.
      allow create: if signedIn() && request.resource.data.type == 'return-reminder'
        && validReturnReminder(request.resource.data);
      allow update: if signedIn() && resource.data.type == 'return-reminder'
        && resource.data.status == 'pending'
        && (
          (request.auth.uid == resource.data.requesterId
            && request.resource.data.status == 'completed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt']))
          || (request.auth.uid == resource.data.ownerId
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancellationReason', 'respondedAt']))
        );
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || resource.data.requesterId == request.auth.uid);
    }

    match /wishlists/{wishId} {
      allow get: if signedIn() && resource.data.userId == request.auth.uid;
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 100
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /savedBooks/{savedBookId} {
      allow get: if signedIn() && resource.data.userId == request.auth.uid;
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 50
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // Ratings are written only by Firebase Functions; no browser writes are allowed.
    match /ratingEvents/{eventId} {
      allow get: if own(resource.data.subjectId);
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 20
        && resource.data.subjectId == request.auth.uid;
      allow write: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reporterShelf is string
        && request.resource.data.category in ['bug', 'idea', 'question']
        && request.resource.data.message is string && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.page is string;
      allow get: if signedIn() && resource.data.reporterId == request.auth.uid;
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 20
        && resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
