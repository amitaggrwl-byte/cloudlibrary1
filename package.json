{
  "name": "cloudlibrary-launch-checks",
  "private": true,
  "scripts": {
    "test:rules": "firebase emulators:exec --config firebase.test.json --only firestore \"node --test tests/firestore.rules.test.js\"",
    "test:functions": "firebase emulators:exec --config firebase.test.json --only firestore \"node --test --test-concurrency=1 tests/loans.emulator.test.js tests/admin.emulator.test.js\"",
    "test:scoring": "node --test tests/scoring.test.js",
    "check": "node --check functions/index.js",
    "build": "tailwindcss -i ./tailwind.css -o ./assets/app.css --minify",
    "demo": "firebase emulators:start --project cloudlibrary-7b9ac --only auth,firestore,storage,functions",
    "demo:seed": "node scripts/seed-demo.js",
    "demo:seed-ui-review": "node scripts/seed-ui-review.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase-tools": "^15.28.2",
    "tailwindcss": "^3.4.17"
  }
}
