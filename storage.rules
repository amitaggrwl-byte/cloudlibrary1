rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Covers use a predictable owner path. Storage does not need to know who
    // may read a cover: a download URL is only written to a friend-readable
    // book document, while upload/delete remains strictly owner-only.
    match /covers/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 350 * 1024
                            && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
